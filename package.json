{
  "name": "atendimento-grazing",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "vite --config apps/atendimento-chat-consulta/vite.config.mts --mode operacao",
    "build": "node scripts/atendimento/compilar-operacao.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps/atendimento-chat-consulta scripts/atendimento/compilar-operacao.mjs scripts/atendimento/publicar-repositorio.mjs prisma7.config.ts",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "publicar": "node scripts/atendimento/publicar-repositorio.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.5",
    "dotenv": "17.4.2",
    "lucide-react": "1.41.0",
    "next-themes": "0.4.6",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "esbuild": "0.28.2",
    "postcss": "8.5.28",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-jsx-a11y": "6.10.2"
  }
}
